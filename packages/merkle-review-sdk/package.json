{
	"name": "@bittasker/merkle-review-sdk",
	"version": "0.1.0",
	"description": "Privacy-preserving verifiable review system using Merkle trees",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src --ext .ts",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"merkle-tree",
		"reviews",
		"verification",
		"blockchain",
		"privacy"
	],
	"author": "BitTasker",
	"license": "MIT",
	"dependencies": {
		"@noble/hashes": "^1.8.0",
		"merkletreejs": "^0.3.11"
	},
	"peerDependencies": {
		"ethers": "^6.15.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@vitest/coverage-v8": "^3.0.0",
		"typescript": "^5.0.0",
		"vite": "^6.0.0",
		"vite-plugin-dts": "^4.0.0",
		"vitest": "^3.0.0"
	}
}

