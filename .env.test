# Network Target
VITE_BITCOIN_NETWORK="testnet"

# Indexer / Esplora REST API (HTTPS with trailing slash required for Rust Url::join)
VITE_ESPLORA_URL="https://blockstream.info/testnet/api/"
VITE_BITCOIN_ELECTRUM_URL="https://blockstream.info/testnet/api/"

# Consignment Transport Endpoint (HTTPS)
VITE_RGB_TRANSPORT_ENDPOINT="https://rgb-proxy.utexo.com/json-rpc"

# RLN Lightning Proxy Gateway (wss:// scheme prevents SDK fallback)
VITE_RGB_PROXY_URL="wss://ln-gateway-signet.utexo.com"
VITE_RGB_LN_PROXY_URL="wss://ln-gateway-signet.utexo.com"

# VSS Service Placeholder (HTTPS scheme prevents Rust unwrap_or_default() panic)
VITE_RGB_VSS_URL="https://127.0.0.1/disabled-vss"

# Nostr Relays
VITE_NOSTR_RELAY_URL="wss://relay.damus.io"
VITE_NOSTR_TASK_RELAY_URL="wss://relay.damus.io"
