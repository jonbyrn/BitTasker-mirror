# Dockerfile.gasless — Standalone NestJS gasless relay service
# Build context: backend/ directory
# Usage: docker build -f Dockerfile.gasless -t gasless-relay .

FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci --no-audit --no-fund

# Copy source code
COPY tsconfig.json tsconfig.build.json nest-cli.json main.ts app.module.ts ./
COPY gasless/ ./gasless/

# Build the application
RUN npx nest build

# Production stage
FROM node:20-alpine

ENV NODE_ENV=production

WORKDIR /app

# Copy built application
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package*.json ./

# Expose the gasless relay port
EXPOSE 4000

# Start the application
CMD ["node", "dist/main.js"]
