{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"strict": false,
		"skipLibCheck": true,
		"outDir": "dist",
		"declaration": true,
		"sourceMap": true,
		"resolveJsonModule": true
	},
	"include": ["main.ts", "app.module.ts", "gasless/**/*.ts"],
	"exclude": ["node_modules", "dist", "gasless/__tests__"]
}
