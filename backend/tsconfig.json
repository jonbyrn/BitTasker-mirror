{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"strict": false,
		"skipLibCheck": true,
		"outDir": "dist",
		"declaration": true,
		"sourceMap": true
	},
	"include": ["gasless/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
