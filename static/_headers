# BitTasker — Cloudflare Workers Static Assets headers
#
# Security headers applied to all routes.
# Immutable asset caching — these files are content-hashed and can never change.
#
# Cloudflare Workers applies these headers automatically at the edge.
# https://developers.cloudflare.com/workers/static-assets/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self)

# Immutable assets: content-hashed files in SvelteKit's _app/immutable directory.
# These files never change — cache for 1 year.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages: short-lived cache since they contain the SPA shell.
# not_found_handling = "single-page-application" serves index.html for non-prerendered routes.
# User-facing HTML should revalidate frequently to pick up new deployments.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Workers must revalidate. An old worker can keep serving the bundle that POSTed /api/v1/events.
/firebase-messaging-sw.js
  Cache-Control: public, max-age=0, must-revalidate

/service-worker.js
  Cache-Control: public, max-age=0, must-revalidate
