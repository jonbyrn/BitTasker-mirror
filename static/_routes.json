{
  "version": 1,
  "description": "This file is used by Cloudflare Pages to determine which routes should be handled by the SvelteKit app vs served as static files",
  "include": [
    "/*"
  ],
  "exclude": [
    "/favicon.ico",
    "/robots.txt",
    "/sitemap.xml",
    "/manifest.json",
    "/site.webmanifest",
    "/apple-touch-icon.png",
    "/favicon-96x96.png",
    "/favicon.svg",
    "/web-app-manifest-192x192.png",
    "/web-app-manifest-512x512.png",
    "/logo.svg",
    "/logo_compact.svg",
    "/map-pin.png",
    "/bittasker_logo.webp",
    "/firebase-messaging-sw.js",
    "/images/*",
    "/illustrations/*",
    "/currency-symbols/*",
    "/locales/*",
    "/_app/immutable/*",
    "/build/*"
  ]
}
