<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External storage scoped to Pictures directory for camera captures -->
    <external-path name="images" path="Pictures/" />
    <!-- App-specific external files directory (no permissions required on API 19+) -->
    <external-files-path name="external_files" path="." />
    <!-- Internal cache for temporary image processing -->
    <cache-path name="cache_images" path="image_cache/" />
</paths>
