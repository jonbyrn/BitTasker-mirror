# E2E Test Environment Configuration
# Copy to .env.local and configure for your test environment

# ===== Application URLs =====
BASE_URL=http://localhost:5173
PLAYWRIGHT_TEST_BASE_URL=http://localhost:5173

# ===== Playwright Configuration =====
# See: https://playwright.dev/docs/test-configuration
PLAYWRIGHT_TEST_TIMEOUT=30000
PLAYWRIGHT_TEST_RETRIES=2
PLAYWRIGHT_TEST_REPORTER=html
PLAYWRIGHT_HEADED=false
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_WORKERS=1

# ===== Network Configuration =====
VITE_RSK_NETWORK=testnet
VITE_BSC_NETWORK=testnet

# ===== BSC USDT Configuration =====
# Token address for USDT on BSC testnet
# Default: 0x337610d27c682E347C9cD60BD4b3b107C9d34dDd (testnet)
VITE_BSC_USDT_TOKEN_ADDRESS=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd

# Direct send router address for USDT on BSC
# Get from: https://github.com/ruvnet/wallet-core#direct-send
VITE_BSC_DIRECT_SEND_ROUTER_ADDRESS=

# Fixed fee for direct send in atomic units (wei-like, 6 decimals for USDT)
# Example: 100000 = 0.1 USDT
VITE_BSC_DIRECT_SEND_FIXED_FEE_ATOMIC=0

# ===== RPC Endpoints =====
# BSC Testnet RPC
VITE_BSC_RPC_URL=https://data-seed-prebsc-1-a.binance.org:8545

# RSK Testnet RPC
VITE_RSK_RPC_URL=https://public-node.testnet.rsk.co:443

# ===== Test Account Credentials =====
# IMPORTANT: These should be test-only accounts without real funds
# Do NOT use mainnet accounts

# Test Account 1 (Creator/User 1) - Private Key
VITE_TEST_ACCOUNT_1_PK=

# Test Account 2 (Bidder/User 2) - Private Key
VITE_TEST_ACCOUNT_2_PK=

# ===== Sponsor Service Configuration =====
# Configuration for USDT direct send sponsor service
VITE_SPONSOR_API_URL=
VITE_SPONSOR_API_KEY=

# ===== Debug Options =====
DEBUG=false
DEBUG_SELECTORS=false
DEBUG_NETWORK=false
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# ===== Test Data Options =====
# Pre-seed test accounts with funds
SEED_TEST_ACCOUNTS=true

# Use mock wallet instead of real Web3 wallet
USE_MOCK_WALLET=false

# ===== Network Simulation =====
# Simulate slow network (ms latency)
NETWORK_LATENCY=0

# Simulate network failures
SIMULATE_NETWORK_ERRORS=false

# ===== Transaction Options =====
# Poll interval for transaction confirmation (ms)
TX_POLL_INTERVAL=1000

# Maximum time to wait for transaction confirmation (ms)
TX_MAX_WAIT=30000
