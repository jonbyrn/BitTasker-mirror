# Sponsor Service Configuration
# Copy this file to .env and fill in the required values

# Server Configuration
SPONSOR_SERVICE_PORT=3001
SPONSOR_SERVICE_HOST=0.0.0.0
NODE_ENV=development
LOG_REQUESTS=true

# Database Configuration
DB_USER=sponsor
DB_PASSWORD=change_me_in_production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sponsor_service
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=2000

# Redis Configuration (optional, for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# BSC Mainnet Configuration
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org
BSC_MAINNET_ROUTER_ADDRESS=0x...
BSC_MAINNET_SPONSOR_ADDRESS=0x...
BSC_MAINNET_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# BSC Testnet Configuration
BSC_TESTNET_RPC_URL=https://data-seed-prebsc.binance.org:8545
BSC_TESTNET_ROUTER_ADDRESS=0x...
BSC_TESTNET_SPONSOR_ADDRESS=0x...
BSC_TESTNET_USDT_ADDRESS=0x337610d27ae4ca0cd180003c4de79d4b47663363

# Rate Limiting Configuration
RATE_LIMIT_PER_SENDER=10
RATE_LIMIT_SENDER_WINDOW=60000
RATE_LIMIT_PER_IP=50
RATE_LIMIT_IP_WINDOW=60000

# Confirmation Polling Configuration
CONFIRMATION_POLL_INTERVAL=2000
CONFIRMATION_MAX_RETRIES=15
CONFIRMATION_TIMEOUT=30000

# Sentry Error Tracking (optional)
SENTRY_DSN=

# Feature Flags
SKIP_SIGNATURE_VERIFICATION=false
ENABLE_SPONSOR_HEALTH_CHECK=true
