# Cloudflare Workers Development Environment Variables

# Environment
ENVIRONMENT=development

# BSC Network Configuration
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc.binance.org:8545

# Sponsor Addresses (set these to your actual addresses)
BSC_MAINNET_SPONSOR_ADDRESS=
BSC_TESTNET_SPONSOR_ADDRESS=

# Router Addresses (optional for advanced validation)
BSC_MAINNET_ROUTER_ADDRESS=
BSC_TESTNET_ROUTER_ADDRESS=

# Token Addresses
BSC_TESTNET_USDT_ADDRESS=0x337610d27ae4ca0cd180003c4de79d4b47663363

# Rate Limiting Configuration
RATE_LIMIT_PER_IP=50
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_SENDER=10

# Caching Configuration
CACHE_TTL_IDEMPOTENCY=86400
CACHE_TTL_STATUS=300
CACHE_TTL_RATE_LIMIT=60

# Database Configuration (for D1)
D1_DATABASE_ID=
KV_NAMESPACE_ID=
KV_NAMESPACE_PREVIEW_ID=

# Logging
LOG_LEVEL=info
LOG_REQUESTS=true

# Feature Flags
ENABLE_SIGNATURE_VERIFICATION=true
ENABLE_BALANCE_CHECK=true
ENABLE_RATE_LIMITING=true
