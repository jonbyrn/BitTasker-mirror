# Data Models

## Core Entities

### User

```typescript
interface User {
  id: string;
  email: string;
  name: string;
  profilePicture?: string;
  bio?: string;
  location?: {
    address: string;
    coordinates: [number, number];
    radius: number;
  };
  preferences: {
    language: string;
    currency: string;
    notifications: boolean;
    theme: 'light' | 'dark';
  };
  authentication: {
    nostrPublicKey: string;
    nostrPrivateKey: string; // encrypted
    backupPhrase: string; // encrypted
  };
  wallet: {
    bitcoinAddress: string;
    lightningAddress?: string;
    liquidAddress?: string;
    whitelistedAddresses: string[];
  };
  gamification: {
    level: number;
    experience: number;
    badges: string[];
    streak: number;
  };
  verification: {
    emailVerified: boolean;
    phoneVerified: boolean;
    identityVerified: boolean;
    skillsVerified: string[];
  };
  createdAt: Date;
  updatedAt: Date;
}
```

