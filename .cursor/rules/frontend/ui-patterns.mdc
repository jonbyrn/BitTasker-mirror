<div class="badge badge-warning">Pending</div>
<div class="badge badge-error">Failed</div>

<!-- Form validation -->
<input class="input input-bordered input-success" placeholder="Valid input" />
<input class="input input-bordered input-error" placeholder="Invalid input" />

<!-- Alert messages - ALWAYS use alert-outline for consistency -->
<div class="alert alert-outline alert-success">
  <span>Task completed successfully!</span>
</div>
<div class="alert alert-outline alert-error">
  <span>Payment failed. Please try again.</span>
</div>

<!-- Progress indicators -->
