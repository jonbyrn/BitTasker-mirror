### Asset Preloading

```svelte
<script>
  import { onMount } from 'svelte';
  
  onMount(() => {
    // Preload critical assets
    const criticalAssets = [
      '/images/logo.svg',
      '/fonts/inter-regular.woff2',
      '/icons/bitcoin.svg'
    ];
    
    criticalAssets.forEach(asset => {
      const link = document.createElement('link');
      link.rel = 'preload';
      link.href = asset;
      link.as = asset.endsWith('.woff2') ? 'font' : 'image';
      if (asset.endsWith('.woff2')) {
        link.crossOrigin = 'anonymous';
      }
      document.head.appendChild(link);
    });
  });
</script>
```

## Runtime Performance

### Virtual Scrolling

```svelte
<script>
  import { onMount } from 'svelte';
  
  let container = $state();
  let items = $state([]);
  let visibleItems = $state([]);
  let scrollTop = $state(0);
  let itemHeight = 60;
  let containerHeight = 400;
  
  $effect(() => {
    if (!container) return;
    
    const startIndex = Math.floor(scrollTop / itemHeight);
    const endIndex = Math.min(
      startIndex + Math.ceil(containerHeight / itemHeight) + 1,
      items.length
    );
    
    visibleItems = items.slice(startIndex, endIndex);
  });
  
  function handleScroll(event) {
    scrollTop = event.target.scrollTop;
  }
</script>

<div 
  bind:this={container}
  class="virtual-scroll-container"
  style="height: {containerHeight}px; overflow-y: auto;"
  onscroll={handleScroll}
>
  <div style="height: {items.length * itemHeight}px; position: relative;">
    {#each visibleItems as item, index}
      <div 
        class="virtual-item"
        style="position: absolute; top: {(startIndex + index) * itemHeight}px; height: {itemHeight}px;"
      >
        {item.content}
      </div>
    {/each}
  </div>
</div>
```

### Debounced Operations

```typescript
// Debounced search
export function createDebouncedSearch<T>(
  searchFn: (query: string) => Promise<T[]>,
  delay: number = 300
) {
  let timeoutId: number | null = null;
  let currentQuery = '';
  
  return {
    search: async (query: string): Promise<T[]> => {
      currentQuery = query;
      
      if (timeoutId) {
        clearTimeout(timeoutId);
      }
      
      return new Promise((resolve) => {
        timeoutId = setTimeout(async () => {
          if (currentQuery === query) {
            const results = await searchFn(query);
            resolve(results);
          }
        }, delay);
      });
    }
  };
}
```

### Memoization Patterns

```typescript
// Memoization for expensive computations
const memoCache = new Map<string, any>();

export function memoize<T extends (...args: any[]) => any>(
  fn: T,
  keyGenerator?: (...args: Parameters<T>) => string
): T {
  return ((...args: Parameters<T>) => {
    const key = keyGenerator ? keyGenerator(...args) : JSON.stringify(args);
    
    if (memoCache.has(key)) {
      return memoCache.get(key);
    }
    
    const result = fn(...args);
    memoCache.set(key, result);
    return result;
  }) as T;
}

// Usage
const expensiveCalculation = memoize((data: any[]) => {
  return data.reduce((acc, item) => acc + item.value, 0);
});
```

