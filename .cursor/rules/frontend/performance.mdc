# Performance Rules

## Overview

BitTasker prioritizes performance across web and mobile platforms. This document outlines optimization patterns, bundle strategies, and runtime performance best practices using Vite 6.0+, SvelteKit 2.0+, and modern web technologies.

## Core Principles

### Performance-First Development

- **Measure before optimizing** - use performance tools to identify bottlenecks
- **Optimize for mobile first** - mobile devices have limited resources
- **Implement progressive loading** - load critical content first
- **Use modern web standards** - leverage native browser optimizations

### Bundle Optimization

- **Tree shaking** - eliminate unused code
- **Code splitting** - load only necessary code
- **Asset optimization** - compress and optimize resources
- **Lazy loading** - defer non-critical resources

## Vite Configuration Optimization

### Base Vite Configuration

```typescript
// vite.config.ts
import { defineConfig } from 'vite';
import { sveltekit } from '@sveltejs/kit/vite';

export default defineConfig({
  plugins: [sveltekit()],
  
  build: {
    // Bundle optimization
    rollupOptions: {
      output: {
        manualChunks: {
          // Vendor chunks
          'vendor-react': ['react', 'react-dom'],
          'vendor-svelte': ['svelte', '@sveltejs/kit'],
          'vendor-ui': ['daisyui', 'tailwindcss'],
          'vendor-crypto': ['@noble/ed25519', '@noble/secp256k1'],
          'vendor-blockchain': ['@breez-sdk/connector', 'nostr-tools']
        }
      }
    },
    
    // Asset optimization
    assetsInlineLimit: 4096, // Inline small assets
    chunkSizeWarningLimit: 1000,
    
    // Source maps for production debugging
    sourcemap: true,
    
    // Minification
    minify: 'terser',
    terserOptions: {
      compress: {
        drop_console: true,
        drop_debugger: true
      }
    }
  },
  
  // Development optimizations
  server: {
    fs: {
      allow: ['..']
    }
  },
  
  // Dependency optimization
  optimizeDeps: {
    include: [
      'svelte',
      '@sveltejs/kit',
      'daisyui',
      'tailwindcss'
    ],
    exclude: [
      '@capacitor/core',
      '@capacitor/device'
    ]
  }
});
```

### Advanced Bundle Splitting

```typescript
// Advanced chunk splitting strategy
export default defineConfig({
  build: {
    rollupOptions: {
      output: {
        manualChunks: (id) => {
          // Core framework
          if (id.includes('svelte') || id.includes('@sveltejs')) {
            return 'svelte-core';
          }
          
          // UI components
          if (id.includes('daisyui') || id.includes('tailwindcss')) {
            return 'ui-components';
          }
          
          // Blockchain libraries
          if (id.includes('@breez-sdk') || id.includes('nostr-tools')) {
            return 'blockchain';
          }
          
          // Crypto libraries
          if (id.includes('@noble/') || id.includes('crypto')) {
            return 'crypto';
          }
          
          // Capacitor plugins
          if (id.includes('@capacitor/')) {
            return 'capacitor';
          }
          
          // Large dependencies
          if (id.includes('node_modules')) {
            return 'vendor';
          }
        }
      }
    }
  }
});
```

## Code Splitting Patterns

### Route-Based Code Splitting

```typescript
// Lazy load route components
const routes = {
  '/dashboard': () => import('./routes/dashboard/+page.svelte'),
  '/tasks': () => import('./routes/tasks/+page.svelte'),
  '/wallet': () => import('./routes/wallet/+page.svelte'),
  '/messages': () => import('./routes/messages/+page.svelte')
};

// Dynamic route loading
export async function load({ params }) {
  const component = await routes[params.route];
  return { component };
}
```

### Component Lazy Loading

```svelte
<script>
  import { onMount } from 'svelte';
  
  let HeavyComponent = null;
  let isLoading = $state(false);
  
  onMount(async () => {
    // Only load on mobile or when needed
    if (window.innerWidth < 768) {
      isLoading = true;
      const module = await import('./HeavyComponent.svelte');
      HeavyComponent = module.default;
      isLoading = false;
    }
  });
</script>

{#if isLoading}
  <div class="loading loading-spinner"></div>
{:else if HeavyComponent}
  <svelte:component this={HeavyComponent} />
{/if}
```

### Dynamic Import Patterns

```typescript
// Conditional loading based on platform
export async function loadCapacitorPlugin(pluginName: string) {
  if (typeof window !== 'undefined' && 'Capacitor' in window) {
    try {
      const plugin = await import(`@capacitor/${pluginName}`);
      return plugin;
    } catch (error) {
      console.warn(`Plugin ${pluginName} not available:`, error);
      return null;
    }
  }
  return null;
}

// Lazy load based on user interaction
export function createLazyLoader<T>(
  importFn: () => Promise<T>,
  condition: () => boolean
) {
  let loaded = false;
  let promise: Promise<T> | null = null;
  
  return {
    load: async (): Promise<T> => {
      if (loaded) return promise;
      if (!condition()) return null;
      
      promise = importFn();
      loaded = true;
      return promise;
    }
  };
}
```

## Asset Optimization

### Image Optimization

```typescript
// Image optimization utility
export function optimizeImage(src: string, options: {
  width?: number;
  height?: number;
  quality?: number;
  format?: 'webp' | 'avif' | 'jpeg' | 'png';
}) {
  const { width, height, quality = 80, format = 'webp' } = options;
  
  // Use responsive images
  const srcSet = [
    `${src}?w=400&q=${quality}&f=${format} 400w`,
    `${src}?w=800&q=${quality}&f=${format} 800w`,
    `${src}?w=1200&q=${quality}&f=${format} 1200w`
  ].join(', ');
  
  return {
    src: `${src}?w=${width || 800}&q=${quality}&f=${format}`,
    srcSet,
    sizes: '(max-width: 400px) 400px, (max-width: 800px) 800px, 1200px'
  };
}
```

