### Loading States with Error Handling

```svelte
<!-- AsyncComponent.svelte -->
<script>
  import { errorStore } from '$lib/stores/error.store';
  
  let { asyncOperation } = $props();
  
  let data = $state(null);
  let loading = $state(false);
  let error = $state(null);
  
  async function execute() {
    loading = true;
    error = null;
    
    try {
      data = await asyncOperation();
    } catch (err) {
      error = err;
      errorStore.addError(err);
    } finally {
      loading = false;
    }
  }
  
  // Auto-execute on mount
  onMount(execute);
</script>

{#if loading}
  <div class="loading loading-spinner loading-md"></div>
{:else if error}
  <div class="alert alert-error">
    <span>{error.message}</span>
    <button class="btn btn-sm" onclick={execute}>Retry</button>
  </div>
{:else if data}
  <!-- Render data -->
  <div>{data}</div>
{/if}
```

## Error Recovery Patterns

### Retry Logic

```typescript
// Retry logic for recoverable errors
export class RetryHandler {
  static async withRetry<T>(
    operation: () => Promise<T>,
    maxRetries: number = 3,
    delay: number = 1000
  ): Promise<T> {
    let lastError: Error;
    
    for (let attempt = 0; attempt <= maxRetries; attempt++) {
      try {
        return await operation();
      } catch (error) {
        lastError = error;
        
        if (attempt === maxRetries) {
          throw error;
        }
        
        // Check if error is retryable
        if (error.retryable === false) {
          throw error;
        }
        
        // Wait before retry
        await new Promise(resolve => setTimeout(resolve, delay * Math.pow(2, attempt)));
      }
    }
    
    throw lastError;
  }
}
```

### Fallback Strategies

```typescript
// Fallback strategies for service failures
export class FallbackHandler {
  static async withFallback<T>(
    primaryOperation: () => Promise<T>,
    fallbackOperation: () => Promise<T>
  ): Promise<T> {
    try {
      return await primaryOperation();
    } catch (error) {
      console.warn('Primary operation failed, using fallback:', error);
      return await fallbackOperation();
    }
  }
  
  static async withCacheFallback<T>(
    operation: () => Promise<T>,
    cacheKey: string,
    ttl: number = 300000 // 5 minutes
  ): Promise<T> {
    try {
      const result = await operation();
      // Cache result
      localStorage.setItem(cacheKey, JSON.stringify({
        data: result,
        timestamp: Date.now()
      }));
      return result;
    } catch (error) {
      // Try cache
      const cached = localStorage.getItem(cacheKey);
      if (cached) {
        const { data, timestamp } = JSON.parse(cached);
        if (Date.now() - timestamp < ttl) {
          return data;
        }
      }
      throw error;
    }
  }
}
```

## Error Logging and Monitoring

### Error Logger

```typescript
// Error logging service
export class ErrorLogger {
  static logError(error: AppError, context?: Record<string, any>) {
    const logEntry = {
      ...error,
      context,
      userAgent: navigator.userAgent,
      url: window.location.href,
      timestamp: new Date().toISOString()
    };
    
    // Console logging for development
    if (process.env.NODE_ENV === 'development') {
      console.error('Error logged:', logEntry);
    }
    
    // Send to external service in production
    if (process.env.NODE_ENV === 'production') {
      this.sendToExternalService(logEntry);
    }
  }
  
  private static async sendToExternalService(logEntry: any) {
    try {
      await fetch('/api/errors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(logEntry)
      });
    } catch (error) {
      console.error('Failed to send error log:', error);
    }
  }
}
```

## Best Practices

### 1. Error Design

- **Classify errors properly** by type and severity
- **Provide actionable messages** for users
- **Implement graceful degradation** when possible
- **Log errors with context** for debugging

### 2. User Experience

- **Show errors at the right level** (component, page, global)
- **Provide retry mechanisms** for recoverable errors
- **Use consistent error UI** across the application
- **Implement error boundaries** to prevent crashes

### 3. Development

- **Test error scenarios** thoroughly
- **Mock external services** for error testing
- **Implement proper error types** with TypeScript
- **Use error boundaries** to isolate failures

### 4. Monitoring

- **Track error rates** and patterns
- **Set up alerts** for critical errors
- **Monitor error recovery** success rates
- **Analyze error trends** for improvements

### 5. Security

- **Sanitize error messages** to prevent information leakage
- **Log security-related errors** separately
- **Implement rate limiting** for error reporting
- **Protect sensitive data** in error logs

This comprehensive error handling system ensures robust error management across all layers of the BitTasker application, providing excellent user experience and maintainability.
