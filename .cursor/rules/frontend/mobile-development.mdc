# Mobile Development Rules

## Overview

BitTasker uses Capacitor 7.0+ for cross-platform mobile development, enabling a single codebase for iOS, Android, and Web platforms. This document outlines patterns, best practices, and guidelines for mobile-specific development.

## Core Principles

### Platform Detection

- **Always check platform capabilities** before using native features
- **Use progressive enhancement** - web-first with mobile enhancements
- **Implement graceful fallbacks** for unsupported features
- **Test on actual devices** - simulators don't catch all issues

### Capacitor Plugin Usage

- **Check plugin availability** before calling native methods
- **Handle plugin initialization errors** gracefully
- **Use proper TypeScript types** for plugin interfaces
- **Implement proper cleanup** for event listeners and subscriptions

## Platform Detection Patterns

### Basic Platform Detection

```typescript
import { Capacitor } from '@capacitor/core';

// Check if running on native platform
const isNative = Capacitor.isNativePlatform();

// Get specific platform
const platform = Capacitor.getPlatform(); // 'ios', 'android', 'web'

// Platform-specific code
if (platform === 'ios') {
  // iOS-specific implementation
} else if (platform === 'android') {
  // Android-specific implementation
} else {
  // Web fallback
}
```

### Advanced Platform Detection

```typescript
import { Device } from '@capacitor/device';

const getDeviceInfo = async () => {
  try {
    const info = await Device.getInfo();
    return {
      platform: info.platform,
      model: info.model,
      osVersion: info.osVersion,
      isVirtual: info.isVirtual,
      manufacturer: info.manufacturer
    };
  } catch (error) {
    console.warn('Device info not available:', error);
    return null;
  }
};
```

## Plugin Integration Patterns

### Safe Plugin Usage

```typescript
// Always check plugin availability
const usePlugin = async (pluginName: string, method: string) => {
  try {
    const plugin = await import(`@capacitor/${pluginName}`);
    if (plugin && plugin[method]) {
      return plugin[method];
    }
    throw new Error(`Plugin ${pluginName} not available`);
  } catch (error) {
    console.warn(`Plugin ${pluginName} not available:`, error);
    return null;
  }
};

// Example: Safe biometric usage
const useBiometric = async () => {
  const { NativeBiometric } = await import('capacitor-native-biometric');
  
  try {
    const isAvailable = await NativeBiometric.isAvailable();
    if (isAvailable) {
      return NativeBiometric;
    }
  } catch (error) {
    console.warn('Biometric not available:', error);
  }
  
  return null;
};
```

### Plugin State Management

```typescript
// Create reactive plugin state
import { writable } from 'svelte/store';

interface PluginState {
  isAvailable: boolean;
  isInitialized: boolean;
  error: string | null;
}

const createPluginStore = (pluginName: string) => {
  const initialState: PluginState = {
    isAvailable: false,
    isInitialized: false,
    error: null
  };

  const { subscribe, set, update } = writable(initialState);

  const initialize = async () => {
    try {
      // Plugin-specific initialization
      update(state => ({ ...state, isInitialized: true, error: null }));
    } catch (error) {
      update(state => ({ 
        ...state, 
        error: error.message,
        isInitialized: false 
      }));
    }
  };

  return {
    subscribe,
    initialize
  };
};
```

## Native Feature Integration

### Biometric Authentication

```typescript
import { NativeBiometric } from 'capacitor-native-biometric';

class BiometricService {
  private isAvailable: boolean = false;

  async initialize() {
    try {
      this.isAvailable = await NativeBiometric.isAvailable();
      return this.isAvailable;
    } catch (error) {
      console.warn('Biometric initialization failed:', error);
      return false;
    }
  }

  async authenticate(reason: string = 'Authenticate to continue') {
    if (!this.isAvailable) {
      throw new Error('Biometric authentication not available');
    }

    try {
      await NativeBiometric.verifyIdentity({
        reason,
        title: 'Biometric Authentication',
        subtitle: 'Use your biometric to continue',
        description: 'Use your fingerprint or face to authenticate'
      });
      return true;
    } catch (error) {
      if (error.message === 'User cancelled') {
        return false;
      }
      throw error;
    }
  }

  async storeCredentials(username: string, password: string) {
    if (!this.isAvailable) {
      throw new Error('Biometric storage not available');
    }

    await NativeBiometric.setCredentials({
      username,
      password,
      server: 'bittasker'
    });
  }
}
```

### Push Notifications

```typescript
import { PushNotifications } from '@capacitor/push-notifications';

class NotificationService {
  async initialize() {
    // Request permissions
    const permStatus = await PushNotifications.requestPermissions();
    
    if (permStatus.receive === 'granted') {
      // Register with Apple / Google to get push tokens
      await PushNotifications.register();
    }

    // Listen for registration
    PushNotifications.addListener('registration', (token) => {
      console.log('Registration token: ', token.value);
      // Send token to server
      this.sendTokenToServer(token.value);
    });

    // Listen for push notifications
    PushNotifications.addListener('pushNotificationReceived', (notification) => {
      console.log('Push notification received: ', notification);
      // Handle notification display
    });

    // Listen for notification actions
    PushNotifications.addListener('pushNotificationActionPerformed', (notification) => {
      console.log('Push notification action performed', notification);
      // Handle notification tap
    });
  }

  private async sendTokenToServer(token: string) {
    // Send token to your server
    // Implementation depends on your backend
  }
}
```

### Geolocation

```typescript
import { Geolocation } from '@capacitor/geolocation';

class LocationService {
  async getCurrentPosition(): Promise<GeolocationPosition | null> {
    try {
      const coordinates = await Geolocation.getCurrentPosition({
        enableHighAccuracy: true,
        timeout: 10000,
        maximumAge: 300000
      });
      
      return coordinates;
    } catch (error) {
      console.warn('Geolocation error:', error);
      return null;
    }
  }

  async watchPosition(callback: (position: GeolocationPosition) => void) {
    const watchId = await Geolocation.watchPosition({
      enableHighAccuracy: true,
      timeout: 10000,
      maximumAge: 300000
    }, callback);

    return () => {
      Geolocation.clearWatch({ id: watchId });
    };
  }
}
```

