# Deployment Rules

## Overview

BitTasker uses a multi-platform deployment strategy with Cloudflare Workers, Docker containers, and mobile app stores. This document outlines deployment patterns, infrastructure configuration, and CI/CD best practices.

## Core Principles

### Multi-Platform Deployment

- **Web**: Cloudflare Workers with static site generation
- **Mobile**: Capacitor builds for iOS and Android app stores
- **Infrastructure**: Docker containers with Kubernetes orchestration
- **CDN**: Global content delivery for optimal performance

### Environment Management

- **Development**: Local development with hot reloading
- **Staging**: Pre-production testing environment
- **Production**: Live environment with monitoring and analytics
- **Security**: Environment-specific secrets and configurations

## Cloudflare Workers Deployment

### Wrangler Configuration

```toml
# wrangler.toml
name = "bittasker"
compatibility_date = "2024-01-15"
compatibility_flags = ["nodejs_compat"]

[env.production]
route = "bittasker.com/*"
vars = { ENVIRONMENT = "production" }

[env.staging]
route = "staging.bittasker.com/*"
vars = { ENVIRONMENT = "staging" }

# Site configuration for static assets
[site]
bucket = "./build"
entry-point = "worker.js"

# KV storage for caching
[[kv_namespaces]]
binding = "CACHE"
id = "your-kv-namespace-id"
preview_id = "your-preview-kv-namespace-id"

# Durable Objects for state management
[[durable_objects.bindings]]
name = "TASK_STORE"
class_name = "TaskStore"

# R2 storage for file uploads
[[r2_buckets]]
binding = "FILES"
bucket_name = "bittasker-files"
```

### Worker Implementation

```typescript
// worker.js
import { getAssetFromKV } from '@cloudflare/kv-asset-handler';

export default {
  async fetch(request: Request, env: Env, ctx: ExecutionContext): Promise<Response> {
    const url = new URL(request.url);
    
    // API routes
    if (url.pathname.startsWith('/api/')) {
      return handleAPI(request, env, ctx);
    }
    
    // Static assets
    try {
      return await getAssetFromKV(
        {
          request,
          waitUntil: ctx.waitUntil,
        },
        {
          ASSET_NAMESPACE: env.__STATIC_CONTENT,
          ASSET_MANIFEST: env.__STATIC_CONTENT_MANIFEST,
        }
      );
    } catch (e) {
      return new Response('Not found', { status: 404 });
    }
  }
};

async function handleAPI(request: Request, env: Env, ctx: ExecutionContext): Promise<Response> {
  const url = new URL(request.url);
  const path = url.pathname;
  
  // CORS headers
  const corsHeaders = {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type, Authorization',
  };
  
  // Handle preflight requests
  if (request.method === 'OPTIONS') {
    return new Response(null, { headers: corsHeaders });
  }
  
  // Route handling
  switch (path) {
    case '/api/tasks':
      return handleTasks(request, env);
    case '/api/wallet':
      return handleWallet(request, env);
    case '/api/messages':
      return handleMessages(request, env);
    default:
      return new Response('Not found', { status: 404, headers: corsHeaders });
  }
}
```

