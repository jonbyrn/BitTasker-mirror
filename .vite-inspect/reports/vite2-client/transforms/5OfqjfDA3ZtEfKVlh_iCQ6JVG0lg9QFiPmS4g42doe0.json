      "result": "import 'svelte/internal/disclose-version';\nimport * as $ from 'svelte/internal/client';\nimport \"$lib/polyfills\";\nimport { goto } from \"$app/navigation\";\nimport { setupMnemonicPasskey } from \"$lib/wallet/mnemonicBiometrics\";\n\nfunction handleImport(_, mnemonic, error) {\n\tconst cleaned = $.get(mnemonic).trim().replace(/\\s+/g, \" \");\n\tconst wordCount = cleaned.split(\" \").length;\n\n\tif (wordCount !== 12 && wordCount !== 24) {\n\t\t$.set(error, \"Please enter a valid 12 or 24-word recovery phrase\");\n\t\treturn;\n\t}\n\n\tsetupMnemonicPasskey(cleaned).then(() => {\n\t\tgoto(\"/dashboard/wallet\");\n\t}).catch((err) => {\n\t\t$.set(error, err instanceof Error ? err.message : \"An unknown error occurred\", true);\n\t});\n}\n\nvar root_1 = $.template(`<p class=\"text-error mt-1 text-xs overflow-ellipsis\"> </p>`);\nvar root = $.template(`<div class=\"p-8 pb-0\"><h2 class=\"mb-6 text-center text-2xl font-bold\">Import Existing Wallet</h2> <div class=\"form-control space-y-6\"><div><span class=\"label-text font-medium\">Enter your seed phrase</span> <textarea class=\"textarea textarea-bordered focus:border-primary h-32 w-full rounded-lg\" placeholder=\"Enter your 12 or 24 word seed phrase separated by spaces\"></textarea> <p class=\"text-base-content/70 mt-1 text-xs\">Your seed phrase is the 12 or 24 words you received when creating your wallet</p> <!></div> <button class=\"btn btn-primary w-full\">Import Wallet</button></div></div>`);\n\nexport default function ImportWallet($$anchor, $$props) {\n\t$.push($$props, true);\n\n\tlet mnemonic = $.state(\"\");\n\tlet error = $.state(\"\");\n\tvar div = root();\n\tvar div_1 = $.sibling($.child(div), 2);\n\tvar div_2 = $.child(div_1);\n\tvar textarea = $.sibling($.child(div_2), 2);\n\n\t$.remove_textarea_child(textarea);\n\n\tvar node = $.sibling(textarea, 4);\n\n\t{\n\t\tvar consequent = ($$anchor) => {\n\t\t\tvar p = root_1();\n\t\t\tvar text = $.child(p, true);\n\n\t\t\t$.reset(p);\n\t\t\t$.