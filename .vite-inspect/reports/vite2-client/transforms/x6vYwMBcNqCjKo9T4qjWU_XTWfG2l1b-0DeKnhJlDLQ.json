      "result": "import 'svelte/internal/disclose-version';\nimport * as $ from 'svelte/internal/client';\n\nvar on_click = (_, handleFeeRateChange) => handleFeeRateChange('slow');\nvar on_click_1 = (__1, handleFeeRateChange) => handleFeeRateChange('medium');\nvar on_click_2 = (__2, handleFeeRateChange) => handleFeeRateChange('fast');\nvar root_1 = $.template(`<div class=\"form-control\"><div class=\"label\"><span class=\"label-text text-sm sm:text-base\">Transaction Speed</span> <span class=\"label-text-alt text-xs\">Higher speed = Higher fees</span></div> <div class=\"grid w-full grid-cols-3 gap-2\"><button><span class=\"flex items-center gap-1\"><span class=\"text-xs sm:text-sm\">🐌</span> <span class=\"text-xs\">Slow</span></span></button> <button><span class=\"flex items-center gap-1\"><span class=\"text-xs sm:text-sm\">🚀</span> <span class=\"text-xs\">Medium</span></span></button> <button><span class=\"flex items-center gap-1\"><span class=\"text-xs sm:text-sm\">⚡</span> <span class=\"text-xs\">Fast</span></span></button></div></div>`);\n\nexport default function FeeSelection($$anchor, $$props) {\n\t$.push($$props, true);\n\n\tlet feeRate = $.prop($$props, 'feeRate', 15, \"medium\"),\n\t\tselectedAsset = $.prop($$props, 'selectedAsset', 3, \"BTC\"),\n\t\tonFeeRateChange = $.prop($$props, 'onFeeRateChange', 3, () => {});\n\n\tfunction handleFeeRateChange(newRate) {\n\t\tfeeRate(newRate);\n\t\tonFeeRateChange()();\n\t}\n\n\tvar fragment = $.comment();\n\tvar node = $.first_child(fragment);\n\n\t{\n\t\tvar consequent = ($$anchor) => {\n\t\t\tvar div = root_1();\n\t\t\tvar div_1 = $.sibling($.child(div), 2);\n\t\t\tvar button = $.child(div_1);\n\n\t\t\tbutton.__click = [on_click, handleFeeRateChange];\n\n\t\t\tvar button_1 = $.sibling(button, 2);\n\n\t\t\tbutton_1.__click = [on_click_1, handleFeeRateChange];\n\n\t\t\tvar button_2 = $.sibling(button_1, 2);\n\n\t\t\tbutton_2.__click = [on_click_2, handleFeeRateChange];\n\t\t\t$.reset(div_1);\n\t\t\t$.reset(div);\n\n\t\t\t$.template_effect(() => {\n\t\t\t\t$.set_class(button, 1, `btn btn-sm sm:btn-md ${feeRate() === 'slow' ? 'btn-primary' : 'btn-outline'}`);\n\t\t\t\t$.set_class(button_1, 1, `btn btn-sm sm:btn-md ${feeRate() === 'medium' ? 'btn-primary' : 'btn-outline'}`);\n\t\t\t\t$.set_class(button_2, 1, `btn btn-sm sm:btn-md ${feeRate() === 'fast' ? 'btn-primary' : 'btn-outline'}`);\n\t\t\t});\n\n\t\t\t$.append($$anchor, div);\n\t\t};\n\n\t\t$.if(node, ($$render) => {\n\t\t\tif (selectedAsset() === 'BTC') $$render(consequent);\n\t\t});\n\t}\n\n\t$.append($$anchor, fragment);\n\t$.pop();\n}\n\n$.delegate(['click']);",
