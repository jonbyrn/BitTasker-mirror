{
	"name": "BitTasker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20.0.0",
		"npm": ">=11.0.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte,json,css,md}": "prettier --write",
		"*.{js,ts,svelte}": "eslint --fix --cache"
	},
	"scripts": {
		"dev": "vite dev --host --port 3000",
		"dev:dev": "vite dev --host --port 3000 --mode development",
		"dev:regtest": "vite dev --host --port 3001 --mode development",
		"build": "npx --yes svelte-kit sync && vite build && node scripts/fix-sveltekit-preview-manifest.mjs && npm run sitemap:generate",
		"build:production": "npx --yes svelte-kit sync && vite build && npm run sitemap:generate",
		"build:dev": "npx --yes svelte-kit sync --mode development && vite build --mode development",
		"preview": "vite preview",
		"cap:sync": "npx cap sync",
		"ios": "npx cap run --live-reload ios",
		"android": "npx cap run --live-reload android",
		"android:build": "npm run build && npx cap sync android",
		"android:assembleDebug": "npm run android:build && cd android && ./gradlew assembleDebug",
		"android:assembleRelease": "npm run android:build && cd android && ./gradlew assembleRelease",
		"android:bundleRelease": "npm run android:build && cd android && ./gradlew bundleRelease",
		"android:installDebug": "npm run android:build && cd android && ./gradlew assembleDebug installDebug",
		"apk:dev:debug": "npm run build:dev && NODE_ENV=development npx cap sync && cd android && ./gradlew assembleDebug && cd .. && adb install -r android/app/build/outputs/apk/debug/app-universal-debug.apk",
		"apk:dev:release": "npm run build:dev && NODE_ENV=development npx cap sync && cd android && ./gradlew assembleRelease && cd .. && adb install -r android/app/build/outputs/apk/release/app-universal-release.apk",
		"deploy:workers:dev": "npm run build:dev && wrangler deploy --env dev && ENVIRONMENT=dev node scripts/purge-cache.js",
		"deploy:workers:production": "npm run build:production && wrangler deploy --env production && ENVIRONMENT=production node scripts/purge-cache.js",
		"deploy:workers:staging": "npm run build && wrangler deploy --env=staging && ENVIRONMENT=staging node scripts/purge-cache.js",
		"deploy:preview": "wrangler versions upload --env dev --env-file .env.development --preview-alias $(git branch --show-current | tr '/' '-')",
		"secrets:upload": "bash scripts/upload-secrets.sh staging",
		"secrets:upload:production": "bash scripts/upload-secrets.sh production",
		"release:zapstore": "bash scripts/publish-to-zapstore.sh",
		"prepare": "husky && (npx --yes svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write . --ignore-path .prettierignore",
		"lint": "prettier --check . --ignore-path .prettierignore && eslint .",
		"test:unit": "vitest run",
		"test": "npm run test:unit",
		"test:ci": "vitest run src/lib/tests/unit/ src/lib/tests/integration/ src/lib/tests/components/ --exclude src/lib/tests/integration/services-perf.smoke.test.ts",
		"test:workflow": "node --test tests/codex-plan-workflow.test.mjs",
		"gi": "vitest run src/lib/tests/unit/ src/lib/tests/integration/ src/lib/tests/components/ --exclude src/lib/tests/integration/services-perf.smoke.test.ts",
		"test:e2e:validate-service-bootstrap": "node scripts/validate-service-e2e-bootstrap.mjs",
		"test:reviews:components": "vitest run --config vitest.config.ts src/lib/components/profile/__tests__/ src/lib/components/reviews/__tests__/",
		"test:triage": "node scripts/test-triage.js",
		"test:unit:validators": "vitest run src/lib/tests/unit/helpers/validators.test.ts",
		"test:unit:formatters": "vitest run src/lib/tests/unit/helpers/dateFormatter.test.ts src/lib/tests/unit/helpers/currencyFormatter.test.ts",
		"test:unit:crypto": "vitest run src/lib/tests/unit/helpers/crypto.test.ts src/lib/tests/unit/helpers/encoding.test.ts",
		"test:unit:auth": "vitest run src/lib/tests/unit/helpers/auth.test.ts src/lib/tests/unit/helpers/auth-cache-validation.test.ts src/lib/tests/unit/helpers/auth-error-recovery.test.ts",
		"test:unit:api": "vitest run src/lib/tests/unit/api/",
		"test:unit:nostr": "vitest run src/lib/tests/unit/nostr/",
		"test:unit:utils": "vitest run src/lib/tests/unit/utils/ src/lib/tests/utils/",
		"test:unit:stores": "vitest run src/lib/tests/unit/stores/",
		"test:unit:components": "vitest run --config vitest.config.ts src/lib/tests/components/ src/lib/components/profile/__tests__/ src/lib/components/reviews/__tests__/",
		"test:unit:services": "vitest run src/lib/tests/unit/services/",
		"test:unit:integration": "vitest run src/lib/tests/integration/",
		"test:e2e": "node scripts/e2e-ordered.js",
		"test:e2e:ui": "node scripts/e2e-ordered.js --ui",
		"test:e2e:cross-browser": "npx playwright test cross-browser-smoke",
		"test:e2e:cross-browser:chromium": "npx playwright test cross-browser-smoke --project=chromium",
		"test:e2e:cross-browser:firefox": "npx playwright test cross-browser-smoke --project=firefox",
		"test:e2e:cross-browser:webkit": "npx playwright test cross-browser-smoke --project=webkit",
		"test:e2e:seed": "npx tsx tests/e2e/scripts/seed-chromium.ts",
		"test:e2e:open": "npm run test:e2e:seed && npx playwright open --load-storage=tests/e2e/.auth/chromium-auth.json http://localhost:3000/",
		"test:e2e:codegen": "npm run test:e2e:seed && npx playwright codegen --load-storage=tests/e2e/.auth/chromium-auth.json http://localhost:3000/",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"sitemap:generate": "node scripts/generate-sitemap.js",
		"search:sync": "node scripts/search-sync.mjs",
		"search:index": "node scripts/typesense-indexer.mjs",
		"search:embed": "node scripts/search-embed-backfill.mjs",
		"search:benchmark": "node scripts/search-benchmark.mjs",
		"sitemap:dev": "npm run sitemap:generate && echo 'Sitemap generated for development'",
		"postinstall": "node scripts/patch-rgb-sdk.mjs",
		"postbuild": "node scripts/purge-cache.js",
		"test:cache-purge": "node scripts/test-cache-purge.js",
		"test:android:ci": "bash scripts/test-android-ci-setup.sh",
		"test:android:fastlane-preflight": "ANDROID_SKIP_PLAY_UPLOAD=1 bundle exec fastlane android preflight",
		"test:android:gitlab": "gitlab-ci-local --executor docker --variable CI_COMMIT_TAG=v9.9.9-alpha.0 --variable CI_PIPELINE_ID=2580491315 --variable ANDROID_PIPELINE_OFFSET=2400000000 --variable ANDROID_SKIP_PLAY_UPLOAD=1 android-build-internal",
		"regtest:start": "bash ../meta-tx-relay/start-regtest.sh",
		"regtest:start:skip-deploy": "bash ../meta-tx-relay/start-regtest.sh --skip-deploy",
		"regtest:stop": "bash ../meta-tx-relay/stop-regtest.sh",
		"gitlab:vars:dev": "bash scripts/push-gitlab-variables.sh --scope development --file .env.development",
		"gitlab:vars:prod": "bash scripts/push-gitlab-variables.sh --scope production --file .env",
		"gitlab:vars:dev:dry": "bash scripts/push-gitlab-variables.sh --scope development --file .env.development --dry-run",
		"gitlab:vars:prod:dry": "bash scripts/push-gitlab-variables.sh --scope production --file .env --dry-run",
		"gitlab:vars:dev:delete": "bash scripts/delete-gitlab-variables.sh --scope development --file .env.development",
		"gitlab:vars:prod:delete": "bash scripts/delete-gitlab-variables.sh --scope production --file .env",
		"gitlab:vars:dev:delete:dry": "bash scripts/delete-gitlab-variables.sh --scope development --file .env.development --dry-run",
		"gitlab:vars:prod:delete:dry": "bash scripts/delete-gitlab-variables.sh --scope production --file .env --dry-run"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.0.0",
		"@eslint/compat": "^1.2.5",
