		"nostr-tools": "^2.13.0",
		"photoswipe": "^5.4.4",
		"picomatch": "^4.0.3",
		"process": "^0.11.10",
		"qrcode": "^1.5.4",
		"stream-browserify": "^3.0.0",
		"svelte-i18n": "^4.0.1",
		"svelte-multiselect": "^11.2.3",
		"svelty-picker": "^6.1.6",
		"swiper": "^11.2.6",
		"tailwindcss": "^4.0.0",
		"vite": "^7.0.0",
		"vite-plugin-inspect": "^11.3.2",
		"vite-plugin-pwa": "^1.0.1",
