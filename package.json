		"@nostr-dev-kit/ndk-svelte": "^2.4.5",
		"@types/google.maps": "^3.58.1",
		"axios": "^1.8.4",
		"capacitor-native-biometric": "^4.2.2",
		"date-fns": "^4.1.0",
		"iconify-icon": "^2.3.0",
		"nostr-tools": "^2.13.0",
		"swiper": "^11.2.6",
		"zod": "^3.24.2"
