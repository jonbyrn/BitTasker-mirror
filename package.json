		"@capacitor/status-bar": "^8.0.0",
		"@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
		"@capawesome/capacitor-screen-orientation": "^7.0.1",
		"@cashu/cashu-ts": "^2.1",
		"@cashu/crypto": "^0.3.4",
		"@cloudflare/kv-asset-handler": "^0.3.4",
		"@noble/ciphers": "^1.3.0",
		"@noble/curves": "^1.3.0",
		"@noble/hashes": "^1.8.0",
		"@nostr-dev-kit/blossom": "^8.0.0",
		"@nostr-dev-kit/cache-dexie": "^2.7.8",
		"@nostr-dev-kit/ndk": "^3.0.0",
		"@nostr-dev-kit/sessions": "^1.0.0",
