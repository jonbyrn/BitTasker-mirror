{
	"name": "BitTasker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "vite dev --host --port 3000",
		"dev:app": "vite dev --host --port 3000",
		"ios": "npx cap run --live-reload ios",
		"cap:sync": "npx cap sync",
		"android": "npx cap run --live-reload android",
		"build": "npx --yes svelte-kit sync && vite build && npm run sitemap:generate",
		"preview": "vite preview",
		"prepare": "npx --yes svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"sitemap:generate": "node scripts/generate-sitemap.js",
		"sitemap:dev": "npm run sitemap:generate && echo 'Sitemap generated for development'",
		"deploy:workers": "npm run build && wrangler deploy --env=staging",
		"deploy:workers:production": "npm run build && wrangler deploy --env production",
		"secrets:upload": "bash scripts/upload-secrets.sh staging",
		"secrets:upload:production": "bash scripts/upload-secrets.sh production"
	},
	"devDependencies": {
