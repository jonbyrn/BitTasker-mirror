{
	"name": "BitTasker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"lint-staged": {
		"*.{js,ts,svelte,json,css,md}": "prettier --write",
		"*.{js,ts,svelte}": "eslint --fix"
	},
	"scripts": {
		"dev": "vite dev --host --port 3000 --mode production",
		"dev:dev": "vite dev --host --port 3000 --mode development",
		"build": "npm run robots:copy && npx --yes svelte-kit sync && vite build && node scripts/fix-sveltekit-preview-manifest.mjs && npm run sitemap:generate",
		"build:production": "npm run robots:copy && npx --yes svelte-kit sync && vite build && npm run sitemap:generate",
		"build:dev": "npx --yes svelte-kit sync --mode development && vite build --mode development",
		"preview": "vite preview",
		"cap:sync": "npx cap sync",
		"ios": "npx cap run --live-reload ios",
		"android": "npx cap run --live-reload android",
		"android:build": "npm run build && npx cap sync android",
		"android:build:debug": "npm run android:build && cd android && ./gradlew assembleDebug",
		"android:build:release": "npm run android:build && cd android && ./gradlew assembleRelease",
		"android:bundle:release": "npm run android:build && cd android && ./gradlew bundleRelease",
		"android:install": "cd android && ./gradlew installDebug",
		"android:build:install": "npm run android:build && cd android && ./gradlew assembleDebug installDebug",
		"debug:install": "npm run build:dev && NODE_ENV=development npx cap sync && cd android && ./gradlew assembleDebug && cd .. && adb install -r android/app/build/outputs/apk/debug/app-universal-debug.apk",
		"prepare": "husky && (npx --yes svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest run",
		"test": "npm run test:unit",
		"test:workflow": "node --test tests/codex-plan-workflow.test.mjs",
		"test:ci": "vitest run src/lib/tests/unit/ src/lib/tests/integration/ src/lib/tests/components/ --exclude src/lib/tests/integration/services-perf.smoke.test.ts",
		"test:e2e:validate-service-bootstrap": "node scripts/validate-service-e2e-bootstrap.mjs",
		"test:reviews:components": "vitest run --config vitest.config.ts src/lib/components/profile/__tests__/ src/lib/components/reviews/__tests__/",
		"test:triage": "node scripts/test-triage.js",
		"test:unit:validators": "vitest run src/lib/tests/unit/helpers/validators.test.ts",
		"test:unit:formatters": "vitest run src/lib/tests/unit/helpers/dateFormatter.test.ts src/lib/tests/unit/helpers/currencyFormatter.test.ts",
		"test:unit:crypto": "vitest run src/lib/tests/unit/helpers/crypto.test.ts src/lib/tests/unit/helpers/encoding.test.ts",
		"test:unit:auth": "vitest run src/lib/tests/unit/helpers/auth.test.ts src/lib/tests/unit/helpers/auth-cache-validation.test.ts src/lib/tests/unit/helpers/auth-error-recovery.test.ts",
		"test:unit:api": "vitest run src/lib/tests/unit/api/",
		"test:unit:nostr": "vitest run src/lib/tests/unit/nostr/",
		"test:unit:utils": "vitest run src/lib/tests/unit/utils/ src/lib/tests/utils/",
		"test:unit:stores": "vitest run src/lib/tests/unit/stores/",
		"test:unit:components": "vitest run --config vitest.config.ts src/lib/tests/components/ src/lib/components/profile/__tests__/ src/lib/components/reviews/__tests__/",
		"test:unit:integration": "vitest run src/lib/tests/integration/",
		"test:e2e": "node scripts/e2e-ordered.js",
		"test:e2e:ui": "node scripts/e2e-ordered.js --ui",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"robots:copy": "node scripts/copy-robots-txt.js",
		"sitemap:generate": "node scripts/generate-sitemap.js",
		"sitemap:dev": "npm run sitemap:generate && echo 'Sitemap generated for development'",
		"postbuild": "node scripts/purge-cache.js",
		"test:cache-purge": "node scripts/test-cache-purge.js",
		"deploy:workers": "npm run build && wrangler deploy --env=staging && ENVIRONMENT=staging node scripts/purge-cache.js",
		"deploy:workers:dev": "npm run build && wrangler deploy --env dev && ENVIRONMENT=dev node scripts/purge-cache.js",
		"release:zapstore": "bash scripts/publish-to-zapstore.sh",
		"deploy:workers:production": "npm run build:production && wrangler deploy --env production && ENVIRONMENT=production node scripts/purge-cache.js",
		"secrets:upload": "bash scripts/upload-secrets.sh staging",
		"secrets:upload:production": "bash scripts/upload-secrets.sh production"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@chromatic-com/storybook": "^5.0.0",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@iconify-json/mdi": "^1.2.3",
		"@playwright/test": "^1.58.2",
		"@storybook/addon-svelte-csf": "^5.0.10",
		"@storybook/svelte": "^10.1.11",
		"@storybook/sveltekit": "^10.1.11",
		"@storybook/test": "^8.6.15",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.16",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.4",
		"@typechain/ethers-v6": "^0.5.1",
		"@types/debug": "^4.1.12",
		"@types/qrcode": "^1.5.5",
		"@vitest/browser": "^3.0.8",
		"@vitest/coverage-v8": "^3.2.4",
		"daisyui": "^5.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"jsdom": "^26.0.0",
		"lint-staged": "^15.5.2",
		"playwright": "^1.57.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"rollup-plugin-analyzer": "^4.0.0",
		"rollup-plugin-visualizer": "^6.0.3",
		"storybook": "^10.1.11",
		"svelte": "^5.46.3",
		"svelte-check": "^4.0.0",
		"svelte-sitemap": "^2.7.1",
		"tailwind-scrollbar": "^4.0.2",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typechain": "^8.3.2",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"unplugin-icons": "^22.2.0",
		"vite-plugin-node-polyfills": "^0.24.0",
		"vitest": "^3.0.0",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"@bittasker/reviews-contracts": "file:nostr-reviews-verifier/packages/reviews-contracts/bittasker-reviews-contracts-0.0.1.tgz",
		"@bittasker/wallet-core": "^0.1.10",
		"@capacitor-mlkit/barcode-scanning": "^8.0.1",
		"@capacitor/android": "^8.0.0",
		"@capacitor/app": "^8.0.0",
		"@capacitor/browser": "^8.0.0",
		"@capacitor/cli": "^8.0.0",
		"@capacitor/clipboard": "^8.0.0",
		"@capacitor/core": "^8.0.0",
