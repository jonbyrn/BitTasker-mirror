{
	"name": "bittasker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "vite dev --host --port 3000",
		"dev:app": "vite dev --host --port 3000",
		"ios": "npx cap run --live-reload ios",
		"cap:sync": "npx cap sync",
		"android": "npx cap run --live-reload android",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^3.2.5",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@internationalized/date": "^3.7.0",
		"@storybook/addon-essentials": "^8.6.4",
		"@storybook/addon-svelte-csf": "^5.0.0-next.27",
		"@storybook/blocks": "^8.6.4",
		"@storybook/experimental-addon-test": "^8.6.4",
		"@storybook/svelte": "^8.6.4",
		"@storybook/sveltekit": "^8.6.4",
		"@storybook/test": "^8.6.4",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.4",
		"@vitest/browser": "^3.0.8",
		"@vitest/coverage-v8": "^3.0.8",
		"bits-ui": "^1.3.16",
		"daisyui": "^5.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"houdini": "^1.5.5",
		"houdini-svelte": "^2.1.14",
		"jsdom": "^26.0.0",
		"playwright": "^1.51.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"storybook": "^8.6.4",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.0.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"@capacitor/android": "^7.0.1",
		"@capacitor/app": "^7.0.0",
		"@capacitor/cli": "^7.0.1",
		"@capacitor/core": "^7.0.1",
		"@capacitor/device": "^7.0.0",
		"@capacitor/geolocation": "^7.1.1",
