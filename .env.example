# ============================================
# CLIENT CONFIGURATION
# ============================================
# VITE_CLIENT_URL="http://localhost:3000"

VITE_CLIENT_HOSTNAME="dev.bittasker.com"

CAPACITOR_DEBUG_WEBVIEW="false"

VITE_APP_ID="com.bittasker.app.dev"
VITE_APP_NAME="BitTasker Dev"

VITE_BETA_WARNING=false

# ============================================
# DEVELOPMENT / TESTING CONFIGURATION
# ============================================
# Bypass Passkey for local Playwright testing
VITE_BYPASS_PASSKEY=false

# Test Nostr key (for E2E testing only - NEVER use in production)
TEST_NOSTR_KEY=nsec1...

# ============================================
# API CONFIGURATION
# ============================================
# VITE_API_URL="https://api.bittasker.com" # Prod
# VITE_API_URL="https://api-staging.bittasker.com" # Staging
VITE_API_URL="https://api-dev.bittasker.com" # Dev

# Frontend base URL (SEO, canonical URLs, push notifications, deep links)
# Local: http://localhost:5173 | Production: https://bittasker.com
VITE_CLIENT_URL="https://bittasker.com"

# ============================================
# NOSTR RELAYS
# ============================================
# Staging
VITE_NOSTR_RELAY_URL="wss://relay1-dev.bittasker.com" # Dev relays for all other events
VITE_NOSTR_TASK_RELAY_URL="wss://relay2-dev.bittasker.com" # Dev relay for tasks in websocket format
VITE_NOSTR_RELAY_NESTJS="https://relay2-dev.bittasker.com" # Dev relay for tasks

# VITE_NOSTR_RELAY_URL="wss://relay1.bittasker.com" # Prod relay for all other events
# VITE_NOSTR_TASK_RELAY_URL="wss://relay2.bittasker.com" # prod relay for tasks in websocket format
# VITE_NOSTR_RELAY_NESTJS="https://relay2.bittasker.com" # Prod relay for tasks

# ============================================
# GOOGLE SERVICES
# ============================================
# Google Maps API (Public key - safe to expose, but restrict domains in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY="AIzaSy..."
VITE_GOOGLE_MAPS_ID="d00fd1a4d6927b0b72c9cd28"

# ============================================
# CLOUDFLARE SERVICES
# ============================================
# Cloudflare Turnstile (Public site key - safe to expose)
VITE_CLOUDFLARE_SITEKEY="0x..."

# Cloudflare video streaming 
VITE_STREAM_CUSTOMER_CODE=...

# Cloudflare Turnstile Secret Key (Server-side only - handled by backend API)
# ⚠️  Do NOT add this to frontend - it's only used server-side for verification

# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Firebase web config (Public config - safe to expose)
VITE_FIREBASE_WEB_API_KEY="AIzaSy..."
VITE_FIREBASE_WEB_AUTH_DOMAIN="bittasker-..."
VITE_FIREBASE_WEB_PROJECT_ID="bittasker-..."
VITE_FIREBASE_WEB_STORAGE_BUCKET="bittasker-..."
VITE_FIREBASE_WEB_MESSAGING_SENDER_ID="..."
VITE_FIREBASE_WEB_APP_ID="1:...:web:..."
VITE_FIREBASE_VAPID_KEY="BD..."

# ============================================
# PAYMENT NETWORK CONFIGURATION
# ============================================
# V2 meta-tx relay configuration is retained for non-Rootstock automation.
VITE_TX_RELAY_BASE_URL="https://tx-relay.testnet.bittasker.com" #testnet
VITE_TX_RELAY_BASE_URL="https://tx-relay.bittasker.com" #mainnet
VITE_TX_RELAY_ENABLED=true

# Binance Smart Chain (BSC) Network
VITE_BSC_NETWORK="mainnet"
# Note: BSCScan API key removed - now using free Binance RPC endpoint

# Tether WDK — Bitcoin On-Chain (beta). Required for state.wdk.btcOnchain; unset skips
# the Electrum fetch rather than defaulting to a public third-party server.
# Testnet Electrum (Blockstream) — port 60002 is Bitcoin testnet SSL.
# VITE_BITCOIN_ELECTRUM_URL="ssl://electrum.blockstream.info:60002"
# VITE_BITCOIN_NETWORK="testnet" # 'bitcoin', 'testnet', or 'regtest'

# UTEXO RGB SDK (browser/WASM, @utexo/rgb-sdk-web) — reuses VITE_BITCOIN_ELECTRUM_URL as
# the Esplora/Electrum indexer. All three below are optional; unset ones stay disabled
# rather than defaulting to a third-party RGB proxy/LSP.
# VITE_RGB_TRANSPORT_ENDPOINT="https://rgb-proxy.utexo.com/json-rpc"
# VITE_RGB_LN_PROXY_URL="wss://your-own-ln-gateway"       # enables Lightning; omit on testnet
# VITE_RGB_USDT_ASSET_ID="<real-testnet-rgb-asset-id>"     # required issued RGB20/NIA asset ID

# ============================================
# BUILD-TIME ONLY (Not exposed to users)
# ============================================
# Sentry Configuration (Build-time only - not in bundle)
SENTRY_ORG=org
SENTRY_PROJECT=project-id
SENTRY_URL=https://gt.bittasker.com
VITE_SENTRY_DSN=https://...@o...ingest.us.sentry.io/...
# The SENTRY_AUTH_TOKEN variable is picked up by the Sentry Build Plugin
SENTRY_AUTH_TOKEN=sntrys_...
# Source map upload runs only when CI=true or SENTRY_UPLOAD=true (skipped for local npm run build)
# SENTRY_UPLOAD=true

# ============================================
# DEPLOYMENT SCRIPTS (Local only - never commit)
# ============================================
# Zapstore Publishing (for release script)
# Get your Nostr private key from a Nostr client or generate one at https://nostrkeygen.com
# ⚠️  NEVER commit this value to git! Keep it secure in your password manager.
NOSTR_NSEC="nsec1..."

# Cloudflare Cache Purge (for deployment scripts)
# Required permission: Zone.Cache Purge Everything
# Test with: npm run test:cache-purge
CLOUDFLARE_CACHE_ZONE_ID=your_zone_id_here
CLOUDFLARE_CACHE_PURGE_TOKEN=your_api_token_here

# ============================================
# OBSOLETE / REMOVED VARIABLES
# ============================================
# The following variables have been removed or are no longer used:
# - VITE_BSCSCAN_API_KEY (replaced with free Binance RPC)
# - VITE_CLOUDFLARE_SECRETKEY (server-side only, handled by backend)

# ============================================
# E2E TESTING CONFIGURATION
# ============================================
VITE_E2E_TURNSTILE_BYPASS=true

VITE_BETA_WARNING=false

VITE_REVIEWS_ATTESTATION_API_URL="https://review-attestation.example.workers.dev"

# Build-time feature flags — set to 'true' when external dependency is provisioned
VITE_CHANGELLY_ENABLED=true
VITE_CHANGELLY_FIAT_ENABLED=false
VITE_BAANX_CARDS_ENABLED=false

# Local development: override @bittasker/wallet-core path for testing.
# Leave empty to use the npm package.
# LOCAL_WALLET_CORE=../wallet-core/src

VITE_LIFI_ENABLED=true
VITE_SYMBIOSIS_ENABLED=true

# Search and QVAC. Production stays on Meilisearch with QVAC off.
# Dev uses prefix dev_. Never commit key values.
# SEARCH_PROVIDER=typesense
# TYPESENSE_HOST=https://typesense-dev.bittasker.com
# TYPESENSE_COLLECTION_PREFIX=dev_
# TYPESENSE_SEARCH_ONLY_KEY=
# QVAC_ENABLED=true
# VITE_QVAC_ENABLED=true
# QVAC_BASE_URL=https://qvac-dev.bittasker.com
# QVAC_BEARER_TOKEN=
