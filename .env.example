# ============================================
# DEVELOPMENT / TESTING CONFIGURATION
# ============================================
# Robots.txt configuration (dev/staging/production)
VITE_ROBOTS_TXT="dev"

# Bypass Passkey for local Playwright testing
VITE_BYPASS_PASSKEY=false

# Test Nostr key (for E2E testing only - NEVER use in production)
TEST_NOSTR_KEY=nsec1...

# ============================================
# API CONFIGURATION
# ============================================
# Production Cloudflare
VITE_API_URL="https://api.bittasker.com"
PUBLIC_GRAPHQL_ENDPOINT="https://api.bittasker.com/graph"

# Alternative endpoints (commented out - uncomment as needed):
# Staging
# VITE_API_URL="https://devbackend.production.bittasker.hedgehackers.finance"
# PUBLIC_GRAPHQL_ENDPOINT="https://devbackend.production.bittasker.hedgehackers.finance/graph"
# Local
# VITE_API_URL="http://127.0.0.1:8000"
# PUBLIC_GRAPHQL_ENDPOINT="http://127.0.0.1:8000/graph"

# ============================================
# NOSTR RELAYS
# ============================================
# Staging
VITE_NOSTR_RELAY_URL="wss://relay.bittasker.hedgehackers.finance"
VITE_NOSTR_RELAY_NESTJS="https://relay.bittasker.com"

# Production (commented out - uncomment for production):
# VITE_NOSTR_RELAY_URL="wss://relay1.bittasker.com"
# VITE_NOSTR_RELAY_NESTJS="https://relay2.bittasker.com"

