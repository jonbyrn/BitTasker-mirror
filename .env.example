# ============================================
# BUILD-TIME ONLY (Not exposed to users)
# ============================================
# Sentry Configuration (Build-time only - not in bundle)
SENTRY_ORG=org
SENTRY_PROJECT=project-id
VITE_SENTRY_DSN=https://...@o...ingest.us.sentry.io/...
# The SENTRY_AUTH_TOKEN variable is picked up by the Sentry Build Plugin
SENTRY_AUTH_TOKEN=sntrys_...

# ============================================
# DEPLOYMENT SCRIPTS (Local only - never commit)
# ============================================
# Zapstore Publishing (for release script)
# Get your Nostr private key from a Nostr client or generate one at https://nostrkeygen.com
# ⚠️  NEVER commit this value to git! Keep it secure in your password manager.
NOSTR_NSEC="nsec1..."

# Cloudflare Cache Purge (for deployment scripts)
# Required permission: Zone.Cache Purge Everything
# Test with: npm run test:cache-purge
CLOUDFLARE_CACHE_ZONE_ID=your_zone_id_here
CLOUDFLARE_CACHE_PURGE_TOKEN=your_api_token_here

